{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tower.md",
  "mainBinaryName": "towermd-app",
  "version": "0.0.0",
  "identifier": "net.towermd.desktop",
  "build": {
    "beforeDevCommand": "node scripts/project-pnpm.mjs dev",
    "beforeBuildCommand": "node scripts/project-pnpm.mjs build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tower.md",
        "width": 960,
        "height": 700,
        "minWidth": 700,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "externalBin": ["binaries/towermd"],
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "category": "DeveloperTool",
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}
