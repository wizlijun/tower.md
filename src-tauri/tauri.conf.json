{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tower.md",
  "version": "0.1.0",
  "identifier": "net.towermd.preview.skeleton",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm app:prepare",
    "beforeDevCommand": "pnpm app:prepare:dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tower.md",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/towermd"
    ],
    "resources": {
      "../skills/": "skills/"
    }
  }
}
