{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "towermd task.show",
  "type": "object",
  "required": ["task", "task_card"],
  "properties": {
    "task_card": {"type": "object", "required": ["id", "module", "allowed_paths", "verify", "markdown"]},
    "task": {"type": "object"},
    "temp_rules": {"type": "array", "items": {"type": "object", "required": ["id", "text", "scope", "until", "set_by"]}},
    "delegation": {
      "type": "object",
      "required": ["card", "rules", "sent_back", "report_requests"],
      "properties": {
        "card": {},
        "rules": {"type": "array"},
        "sent_back": {"type": "array", "items": {"type": "object", "required": ["attempt", "reason"]}},
        "report_requests": {"type": "array"}
      }
    }
  }
}
