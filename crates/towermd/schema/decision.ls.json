{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "towermd decision.ls",
  "description": "Decisions recorded from held-question answers (accepted, superseded or voided), those a person recorded in the App from a node reply or an accepted weakening (L3), acceptance takeaways, and decision documents on the canvas.",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "state", "title", "source"],
        "properties": {
          "id": {"type": "string"},
          "state": {"enum": ["accepted", "superseded", "voided", "document"]},
          "title": {"type": "string"},
          "source": {"enum": ["answer", "reply", "weakening", "acceptance", "document"]},
          "decision": {},
          "scope": {},
          "file": {}
        }
      }
    }
  }
}
