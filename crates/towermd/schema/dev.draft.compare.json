{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "towermd dev.draft.compare",
  "type": "object",
  "required": ["current_baseline", "outdated", "stale", "changed_paths", "impact", "comparison"],
  "properties": {
    "current_baseline": {"type": "string"},
    "outdated": {"type": "boolean"},
    "stale": {"type": "boolean"},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "impact": {"type": "object"},
    "comparison": {
      "type": "object",
      "required": ["draft_id", "baseline", "objects", "unchanged", "unassigned"],
      "properties": {
        "draft_id": {"type": "string"},
        "baseline": {"type": "string"},
        "commit": {"type": "string"},
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "object_type", "title", "kinds"],
            "properties": {
              "id": {"type": "string"},
              "object_type": {"type": "string"},
              "title": {"type": "string"},
              "kinds": {"type": "array", "items": {"enum": ["added", "removed", "renamed", "moved", "files", "endpoints", "commands", "content", "merged_into", "split_from"]}}
            }
          }
        },
        "unchanged": {"type": "array", "items": {"type": "string"}},
        "unassigned": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
