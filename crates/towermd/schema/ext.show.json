{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "towermd ext show",
  "type": "object",
  "required": ["revision", "path", "id", "emits", "commands", "problems", "manifest"],
  "properties": {
    "revision": {"type": "string"},
    "path": {"type": "string"},
    "id": {"type": "string"},
    "version": {"type": "string"},
    "type": {"type": "string"},
    "emits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "deterministic", "max_level"],
        "properties": {
          "kind": {"type": "string"},
          "label": {"type": "string"},
          "icon": {"type": "string"},
          "unit": {"type": "string"},
          "deterministic": {"type": "boolean"},
          "max_level": {"enum": ["log", "passive", "active", "time_sensitive"]}
        }
      }
    },
    "commands": {"type": "object", "additionalProperties": {"type": "string"}},
    "problems": {"type": "array", "items": {"type": "string"}},
    "manifest": {}
  }
}
